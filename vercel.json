{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/stickere-moto/",
      "destination": "/stickere-moto",
      "permanent": false
    },
    {
      "source": "/stickere-moto/index.html",
      "destination": "/stickere-moto",
      "permanent": false
    },
    {
      "source": "/redesign/buchetino/",
      "destination": "/redesign/buchetino",
      "permanent": false
    },
    {
      "source": "/redesign/buchetino/index.html",
      "destination": "/redesign/buchetino",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/stickere-moto",
      "destination": "https://stickere-moto.vercel.app/"
    },
    {
      "source": "/stickere-moto/:path*",
      "destination": "https://stickere-moto.vercel.app/:path*"
    },
    {
      "source": "/redesign/buchetino",
      "destination": "https://buchetino-site.vercel.app/"
    },
    {
      "source": "/redesign/assets/:path*",
      "destination": "https://buchetino-site.vercel.app/assets/:path*"
    },
    {
      "source": "/redesign/buchetino/:path*",
      "destination": "https://buchetino-site.vercel.app/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/index.html"
    }
  ],
  "headers": [
    {
      "source": "/redesign/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/stickere-moto/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
