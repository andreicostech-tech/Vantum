{
  "redirects": [
    { "source": "/stickere-moto", "destination": "/stickere-moto/", "permanent": false },
    { "source": "/redesign/buchetino", "destination": "/redesign/buchetino/", "permanent": false },
    { "source": "/redesign/buchetino1", "destination": "/redesign/buchetino1/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/stickere-moto/", "destination": "https://stickere-moto.vercel.app/" },
    { "source": "/stickere-moto/:path*", "destination": "https://stickere-moto.vercel.app/:path*" }
  ],
  "headers": [
    {
      "source": "/stickere-moto/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/redesign/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
